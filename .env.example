# Supabase (@nuxtjs/supabase 기본 키 이름)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_anon_key

# 선택: Nuxt public 별칭 (Vercel에서 NUXT_PUBLIC_* 사용 가능)
NUXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# 서버 전용 — 절대 클라이언트에 노출하지 마세요
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
KAKAO_REST_API_KEY=your_kakao_rest_key

# 카카오 JavaScript 키 (지도/내비) — public
KAKAO_API_KEY=your_kakao_javascript_key
NUXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key

# TMAP (웹 폴백용, 선택)
TMAP_APP_KEY=your_tmap_app_key
NUXT_PUBLIC_TMAP_APP_KEY=your_tmap_app_key
